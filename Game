function tileSolid(m,tx,ty){ if(tx<0||ty<0||tx>=m.w||ty>=m.h) return true; return SOLID.has(m.g[ty][tx]); }
function boxFree(m,x,y,hw,top,bot){
  const x0=Math.floor((x-hw)/TS), x1=Math.floor((x+hw-.01)/TS), y0=Math.floor((y-top)/TS), y1=Math.floor((y+bot-.01)/TS);
  for(let j=y0;j<=y1;j++) for(let i=x0;i<=x1;i++) if(tileSolid(m,i,j)) return false;
  return true;
}

