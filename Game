function qObjs(id){ return QUESTS[id].obj.map(o=>({t:o.t,done:!!o.f()})); }
let questBusy = false;
function startQuest(id){
  if(!QUESTS[id] || S.quests[id]) return;
  if(id==='wolf_trouble') S.cnt.wolfBase = cnt('wolves');
  S.quests[id] = 'active'; toast('NEW QUEST: '+QUESTS[id].title,'good'); Sound.play('quest'); checkQuests();
}
function completeQuest(id){
  const q = QUESTS[id], r = q.reward||{};
  toast('QUEST COMPLETE: '+q.title,'good'); Sound.play('quest');
  if(r.gold){ S.p.gold += r.gold; toast('+'+r.gold+' G','good'); }
  if(r.exp) gainExpToast(r.exp);
  if(r.items) for(const k in r.items) giveItem(k,r.items[k]);
  if(q.next) startQuest(q.next);
}
function checkQuests(){
  if(!S || questBusy) return;
  questBusy = true;
  try{
    for(let it=0; it<8; it++){
      let changed = false;
      Object.keys(S.quests).forEach(id=>{
        if(S.quests[id]!=='active') return;
        const q = QUESTS[id];
        q.obj.forEach((o,i)=>{ const key=id+':'+i; if(!S.objDone[key] && o.f()){ S.objDone[key]=1; toast('Objective complete: '+o.t,'good'); changed=true; } });
        if(q.obj.every(o=>o.f())){ S.quests[id]='done'; completeQuest(id); changed=true; }
      });
      if(!changed) break;
    }
  } finally { questBusy = false; }
  updateTracker();
}

/* ---- effects used by dialogue / objects ---- */
const ACT = {};   // named actions, filled in later sections
function applyFx(fx){
  if(!fx) return;
  if(fx.met) meet(fx.met);
  if(fx.f) for(const k in fx.f) S.flags[k] = fx.f[k];
  if(fx.cnt) for(const k in fx.cnt) S.cnt[k] = cnt(k)+fx.cnt[k];
  if(fx.rel) for(const k in fx.rel) addRel(k,fx.rel[k]);
  if(fx.clue) addClue(fx.clue);
  if(fx.item){ if(Array.isArray(fx.item)) giveItem(fx.item[0],fx.item[1]); else for(const k in fx.item) giveItem(k,fx.item[k]); }
  if(fx.gold){ S.p.gold = Math.max(0,S.p.gold+fx.gold); toast((fx.gold>0?'+':'')+fx.gold+' G',fx.gold>0?'good':'bad'); if(fx.gold>0) Sound.play('pickup'); }
  if(fx.exp) gainExpToast(fx.exp);
  if(fx.quest) startQuest(fx.quest);
  if(fx.mem) addMemory(fx.mem);
  if(fx.heal){ fullHeal(); toast('HP and MP fully restored','good'); Sound.play('heal'); }
  if(fx.fn && ACT[fx.fn]) ACT[fx.fn]();
  checkQuests();
}

