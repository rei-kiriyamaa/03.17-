<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#05060c">
<meta name="apple-mobile-web-app-capable" content="yes">
<script>
window.addEventListener('error',function(e){
  var d=document.getElementById('errbox');
  if(!d){d=document.createElement('pre');d.id='errbox';d.style.cssText='position:fixed;left:0;right:0;top:0;z-index:99999;margin:0;padding:10px;background:#300;color:#fff;font:12px/1.4 monospace;white-space:pre-wrap;max-height:50%;overflow:auto';(document.body||document.documentElement).appendChild(d);}
  d.textContent+='ERROR: '+(e.message||'?')+' @ line '+(e.lineno||'?')+':'+(e.colno||'?')+'\n';
});
</script>
<title>Echoes of the Forgotten</title>
<style>
:root{
  --navy:#0a0e1f; --ink:#05060c; --purple:#2a1a4a; --blue:#5b7bb5; --gold:#e2b45a; --gold2:#f4d98f;
  --text:#ebe4d2; --dim:#9aa0bd; --red:#c4535f; --hp:#d0605a; --mp:#5b8bd6;
  --glass:linear-gradient(180deg,rgba(24,28,62,.88),rgba(9,11,28,.94));
  --line:rgba(226,180,90,.34);
  --serif:"Cinzel","Trajan Pro","Palatino Linotype",Palatino,"Book Antiqua","Iowan Old Style",Georgia,serif;
  --body:"Palatino Linotype",Palatino,"Iowan Old Style","Book Antiqua",Georgia,"Times New Roman",serif;
  --sat:env(safe-area-inset-top,0px); --sab:env(safe-area-inset-bottom,0px);
  --sal:env(safe-area-inset-left,0px); --sar:env(safe-area-inset-right,0px);
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#000;overflow:hidden;overscroll-behavior:none;touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;
  font-family:var(--body);color:var(--text);font-size:16px}
button{font-family:inherit;color:inherit;touch-action:manipulation}
button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.hidden{display:none!important}
#app{position:fixed;top:0;right:0;bottom:0;left:0;overflow:hidden;background:var(--ink)}
#world{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;display:block}
#vignette{position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none;z-index:2;
  background:radial-gradient(ellipse at 50% 46%,rgba(0,0,0,0) 52%,rgba(2,3,12,.62) 100%)}
.screen{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column}

/* ---------- generic UI ---------- */
.btn{display:block;width:100%;min-height:48px;padding:10px 18px;border-radius:10px;cursor:pointer;
  font-family:var(--serif);font-size:16px;letter-spacing:.14em;text-align:center;
  background:linear-gradient(180deg,rgba(44,38,86,.85),rgba(18,16,44,.9));
  border:1px solid var(--line);box-shadow:inset 0 0 18px rgba(226,180,90,.06),0 4px 14px rgba(0,0,0,.45);
  transition:transform .12s,border-color .12s,box-shadow .12s}
.btn:hover:not(:disabled){border-color:var(--gold);box-shadow:inset 0 0 22px rgba(226,180,90,.16),0 0 16px rgba(226,180,90,.22)}
.btn:active:not(:disabled){transform:scale(.98)}
.btn:disabled{opacity:.38;cursor:default;filter:saturate(.5)}
.btn.small{min-height:40px;padding:6px 12px;font-size:13px;width:auto;letter-spacing:.1em}
.btn.gold{border-color:var(--gold);color:var(--gold2)}
.btn.danger{border-color:rgba(196,83,95,.6)}
.panel{background:var(--glass);border:1px solid var(--line);border-radius:14px;box-shadow:0 10px 50px rgba(0,0,0,.65),inset 0 0 40px rgba(91,123,181,.06);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.h-serif{font-family:var(--serif);letter-spacing:.16em;color:var(--gold2);font-weight:600}
.dim{color:var(--dim)}
.gold{color:var(--gold2)}
.bar{height:9px;background:rgba(0,0,0,.55);border-radius:6px;overflow:hidden;border:1px solid rgba(255,255,255,.1)}
.bar>i{display:block;height:100%;width:100%;transition:width .3s ease}
.bar.hp>i{background:linear-gradient(90deg,#8d3340,#e0805a)}
.bar.mp>i{background:linear-gradient(90deg,#34559f,#76b0ff)}
.bar.xp>i{background:linear-gradient(90deg,#8a6a24,#f4d98f)}
.bar.rel>i{background:linear-gradient(90deg,#6b3a8a,#d58bd0)}

/* ---------- title ---------- */
#title{z-index:30;align-items:center;justify-content:center;padding:calc(var(--sat) + 16px) 20px calc(var(--sab) + 16px);
  background:radial-gradient(ellipse at 50% 30%,rgba(10,14,31,0) 0%,rgba(5,6,12,.55) 80%)}
#logo{text-align:center;font-family:var(--serif);line-height:1.04;margin-bottom:clamp(18px,5vh,44px);
  text-shadow:0 0 28px rgba(226,180,90,.45),0 2px 0 #000}
#logo .l1{display:block;font-size:clamp(40px,10.5vw,92px);letter-spacing:.24em;padding-left:.24em;font-weight:700;
  background:linear-gradient(180deg,#fff2c6,#e2b45a 55%,#9a6e22);-webkit-background-clip:text;background-clip:text;color:transparent}
#logo .l2{display:block;font-size:clamp(13px,3.2vw,22px);letter-spacing:.7em;padding-left:.7em;color:var(--blue);margin:.55em 0}
#logo .l3{display:block;font-size:clamp(30px,8vw,70px);letter-spacing:.2em;padding-left:.2em;font-weight:600;
  background:linear-gradient(180deg,#d9d2ff,#7a6ad0 70%,#4a3a96);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 14px rgba(122,106,208,.5))}
#titleMenu{width:min(320px,86vw);display:flex;flex-direction:column;gap:12px}
#titleSub{margin-top:22px;font-size:13px;letter-spacing:.12em;color:var(--dim);text-align:center;min-height:18px}
#titlePanel{position:absolute;top:0;right:0;bottom:0;left:0;z-index:5;display:flex;align-items:center;justify-content:center;padding:calc(var(--sat) + 12px) 12px calc(var(--sab) + 12px);background:rgba(3,4,10,.72)}
#titlePanel .panel{width:min(560px,100%);max-height:100%;overflow:auto;padding:18px}

/* ---------- HUD ---------- */
#hud{position:absolute;left:0;right:0;top:0;z-index:5;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;
  padding:calc(var(--sat) + 8px) calc(var(--sar) + 10px) 0 calc(var(--sal) + 10px);pointer-events:none}
.hud-card{background:var(--glass);border:1px solid var(--line);border-radius:10px;padding:6px 9px;font-size:12px;
  -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
#hudL{width:min(172px,44vw)}
#hudL .row{display:flex;align-items:center;gap:6px;margin-top:4px}
#hudL .row b{width:20px;font-family:var(--serif);font-size:10px;letter-spacing:.06em;color:var(--dim);font-weight:600}
#hudL .bar{flex:1}
#hudL .num{font-size:10px;color:var(--dim);min-width:46px;text-align:right}
#hudLv{font-family:var(--serif);letter-spacing:.12em;color:var(--gold2);font-size:12px}
#hudR{display:flex;gap:8px;align-items:flex-start}
#hudInfo{text-align:right;line-height:1.35}
#hudTime{font-family:var(--serif);font-size:15px;color:var(--gold2);letter-spacing:.08em}
#btnMenu{pointer-events:auto;min-width:48px;min-height:48px;border-radius:12px;border:1px solid var(--line);background:var(--glass);
  font-family:var(--serif);font-size:11px;letter-spacing:.14em;color:var(--gold2);cursor:pointer}
#tracker{position:absolute;left:calc(var(--sal) + 10px);top:calc(var(--sat) + 78px);z-index:5;max-width:min(300px,62vw);font-size:12px;line-height:1.35;
  color:var(--gold2);text-shadow:0 1px 3px #000,0 0 8px #000;pointer-events:none}
#tracker .tq{font-family:var(--serif);letter-spacing:.1em;font-size:11px}
#tracker .to{color:var(--text);opacity:.9}
#banner{position:absolute;left:0;right:0;top:26%;z-index:8;text-align:center;pointer-events:none;opacity:0;
  font-family:var(--serif);font-size:clamp(24px,6vw,48px);letter-spacing:.34em;padding-left:.34em;color:var(--gold2);
  text-shadow:0 0 24px rgba(226,180,90,.55),0 2px 0 #000}
#banner small{display:block;font-size:.34em;letter-spacing:.4em;color:var(--blue);margin-top:.8em}
#banner.show{animation:bannerA 3.2s ease forwards}
@keyframes bannerA{0%{opacity:0;transform:translateY(8px)}18%{opacity:1;transform:none}75%{opacity:1}100%{opacity:0}}

/* ---------- controls ---------- */
#controls{position:absolute;top:0;right:0;bottom:0;left:0;z-index:6;pointer-events:none}
#stick{position:absolute;left:calc(var(--sal) + 16px);bottom:calc(var(--sab) + 22px);width:150px;height:150px;border-radius:50%;pointer-events:auto;touch-action:none;
  background:radial-gradient(circle,rgba(36,42,92,.5),rgba(10,12,30,.4));border:2px solid rgba(226,180,90,.38)}
#knob{position:absolute;left:50%;top:50%;width:62px;height:62px;margin:-31px 0 0 -31px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#f6dd9e,#b98a3a);box-shadow:0 0 18px rgba(226,180,90,.55),inset 0 -4px 8px rgba(0,0,0,.3)}
.cbtn{position:absolute;border-radius:50%;pointer-events:auto;touch-action:none;display:flex;align-items:center;justify-content:center;
  font-family:var(--serif);font-size:11px;letter-spacing:.08em;color:var(--gold2);cursor:pointer;
  background:radial-gradient(circle at 35% 30%,rgba(60,54,120,.85),rgba(14,12,38,.88));border:2px solid rgba(226,180,90,.5);box-shadow:0 4px 14px rgba(0,0,0,.5)}
.cbtn.on{box-shadow:0 0 24px rgba(244,217,143,.85),0 4px 14px rgba(0,0,0,.5);border-color:var(--gold2)}
.cbtn:active{transform:scale(.94)}
#btnInteract{width:84px;height:84px;right:calc(var(--sar) + 18px);bottom:calc(var(--sab) + 26px);font-size:12px}
#btnAttack{width:68px;height:68px;right:calc(var(--sar) + 112px);bottom:calc(var(--sab) + 22px)}
#btnSkill{width:68px;height:68px;right:calc(var(--sar) + 30px);bottom:calc(var(--sab) + 118px)}

/* ---------- dialogue ---------- */
#dialogue{position:absolute;left:0;right:0;bottom:0;z-index:25;display:flex;justify-content:center;pointer-events:none;
  padding:0 10px calc(var(--sab) + 12px)}
.dlg-box{pointer-events:auto;width:min(780px,100%);display:flex;gap:12px;padding:12px;cursor:pointer;min-height:132px}
#dlgPortraitWrap{flex:0 0 auto;width:92px;height:92px;border-radius:10px;overflow:hidden;border:1px solid var(--line);
  background:radial-gradient(circle at 50% 30%,#2a2e66,#0a0c20);align-self:flex-start}
#dlgPortrait{width:100%;height:100%;display:block}
.dlg-main{flex:1;min-width:0;position:relative}
#dlgName{font-family:var(--serif);letter-spacing:.2em;color:var(--gold2);font-size:14px;margin-bottom:6px;min-height:18px}
#dlgText{font-size:clamp(15px,3.9vw,18px);line-height:1.5;min-height:50px;white-space:pre-wrap}
#dlgText.narr{font-style:italic;color:#cfd6f2}
#dlgChoices{display:flex;flex-direction:column;gap:8px;margin-top:10px}
#dlgChoices .btn{text-align:left;letter-spacing:.02em;font-family:var(--body);font-size:15px;min-height:46px}
#dlgNext{position:absolute;right:2px;bottom:-2px;color:var(--gold);font-size:14px;animation:bob 1s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(4px)}}
@media (max-width:420px){#dlgPortraitWrap{width:64px;height:64px}.dlg-box{gap:9px;padding:10px}}

/* ---------- toasts ---------- */
#toasts{position:absolute;top:calc(var(--sat) + 70px);left:0;right:0;z-index:100;display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none}
.toast{max-width:min(420px,92vw);padding:8px 16px;border-radius:999px;background:var(--glass);border:1px solid var(--line);font-size:13px;
  letter-spacing:.04em;text-align:center;animation:toastA 3s ease forwards}
.toast.good{border-color:var(--gold);color:var(--gold2)}
.toast.bad{border-color:rgba(196,83,95,.7);color:#f0a8b0}
.toast.clue{border-color:rgba(122,106,208,.8);color:#cfc8ff}
@keyframes toastA{0%{opacity:0;transform:translateY(-8px)}10%{opacity:1;transform:none}80%{opacity:1}100%{opacity:0;transform:translateY(-6px)}}

/* ---------- menu (in-game) / shop / puzzle ---------- */
#menu,#shop,#puzzle{z-index:35;align-items:center;justify-content:center;background:rgba(3,4,10,.74);
  padding:calc(var(--sat) + 10px) calc(var(--sar) + 10px) calc(var(--sab) + 10px) calc(var(--sal) + 10px)}
.mpanel{width:min(920px,100%);height:min(680px,100%);display:flex;flex-direction:column;padding:12px 14px;gap:8px}
.mhead{display:flex;align-items:center;justify-content:space-between;gap:10px}
.mhead h2{margin:0;font-family:var(--serif);font-size:18px;letter-spacing:.24em;color:var(--gold2)}
.tabs{display:flex;flex-wrap:wrap;gap:6px}
.tab{min-height:40px;padding:6px 12px;border-radius:9px;border:1px solid rgba(226,180,90,.2);background:rgba(20,22,50,.7);
  font-family:var(--serif);font-size:12px;letter-spacing:.1em;cursor:pointer;color:var(--dim)}
.tab.on{border-color:var(--gold);color:var(--gold2);background:rgba(60,48,110,.7)}
.mbody{flex:1;overflow:auto;-webkit-overflow-scrolling:touch;padding:4px 2px;min-height:0}
.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:12px}
@media (max-width:700px){.split{grid-template-columns:1fr}}
.list{display:flex;flex-direction:column;gap:6px}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:46px;padding:8px 12px;border-radius:10px;cursor:pointer;
  background:rgba(22,24,54,.7);border:1px solid rgba(226,180,90,.14)}
.row.sel{border-color:var(--gold);background:rgba(60,48,110,.7)}
.row.off{opacity:.45}
.row .sub{font-size:12px;color:var(--dim)}
.card{padding:12px;border-radius:12px;background:rgba(14,16,40,.7);border:1px solid rgba(226,180,90,.18)}
.card h3{margin:0 0 6px;font-family:var(--serif);font-size:14px;letter-spacing:.14em;color:var(--gold2)}
.kv{display:grid;grid-template-columns:1fr auto;gap:4px 14px;font-size:15px}
.kv b{font-weight:400;color:var(--dim)}
.pos{color:#8fd6a0}.neg{color:#e58a92}
.obj{display:flex;gap:8px;font-size:14px;line-height:1.4;margin:3px 0}
.obj.done{color:var(--dim);text-decoration:line-through}
.tag{display:inline-block;font-size:10px;letter-spacing:.1em;padding:2px 7px;border-radius:6px;border:1px solid var(--line);color:var(--gold2);margin-left:6px;font-family:var(--serif)}
.empty{padding:26px 10px;text-align:center;color:var(--dim);font-style:italic}
.setrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(226,180,90,.12)}
.setrow .btn{width:140px}
.slot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border-radius:10px;margin-bottom:8px;
  background:rgba(22,24,54,.7);border:1px solid rgba(226,180,90,.18)}
.slot .info{font-size:13px;line-height:1.4;min-width:0}
.slot .info b{font-family:var(--serif);letter-spacing:.12em;color:var(--gold2);font-weight:600}

/* ---------- puzzle ---------- */
#puzzle .mpanel{width:min(460px,100%);height:auto;max-height:100%;overflow:auto;align-items:center;text-align:center;padding:18px 16px}
#pzClue{font-style:italic;color:#cfd6f2;font-size:16px;line-height:1.5;margin:4px 0 2px}
#pzDial{position:relative;width:150px;height:150px;border-radius:50%;margin:8px auto;border:2px solid var(--gold);
  background:radial-gradient(circle,#1a1c44,#07081a);box-shadow:0 0 30px rgba(226,180,90,.3),inset 0 0 30px rgba(0,0,0,.7)}
#pzDial .hand{position:absolute;left:50%;bottom:50%;width:3px;transform-origin:50% 100%;background:var(--gold2);border-radius:2px}
#pzDial .hand.h{height:38px;transform:rotate(90deg)}
#pzDial .hand.m{height:56px;transform:rotate(100deg);width:2px}
#pzDial.ok{animation:dialOk 1.2s ease}
@keyframes dialOk{0%{box-shadow:0 0 30px rgba(226,180,90,.3)}40%{box-shadow:0 0 90px rgba(244,217,143,.95)}100%{box-shadow:0 0 40px rgba(244,217,143,.6)}}
#pzSlots{display:flex;gap:12px;justify-content:center;margin:6px 0}
#pzSlots i{width:20px;height:20px;border-radius:50%;border:2px solid var(--gold);display:block;font-style:normal;font-size:11px;line-height:16px;font-family:var(--serif)}
#pzSlots i.f{background:var(--gold);color:#000;box-shadow:0 0 10px var(--gold)}
#pzKeys{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;width:100%;margin:6px 0}
#pzKeys .btn{min-height:68px;font-size:22px;padding:6px}
#pzMsg{min-height:44px;font-size:14px;color:var(--dim);line-height:1.4}
.shake{animation:shk .45s}
@keyframes shk{20%{transform:translateX(-9px)}40%{transform:translateX(8px)}60%{transform:translateX(-6px)}80%{transform:translateX(4px)}}

/* ---------- battle ---------- */
#battle{z-index:40;background:#05060c;align-items:center;padding:calc(var(--sat) + 0px) 0 calc(var(--sab) + 0px)}
#btlWrap{width:min(760px,100%);height:100%;display:flex;flex-direction:column;gap:6px;padding:8px 8px 8px}
#btlStage{position:relative;flex:1;min-height:180px;border-radius:14px;overflow:hidden;border:1px solid var(--line)}
#btlCanvas{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;display:block}
#btlEnemy{position:absolute;left:10px;right:10px;top:10px;pointer-events:none}
#btlEnemyName{font-family:var(--serif);letter-spacing:.2em;font-size:14px;color:var(--gold2);text-shadow:0 2px 6px #000;display:flex;justify-content:space-between}
#btlEnemy .bar{height:12px;margin-top:4px}
#dmgLayer{position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none;overflow:hidden}
.dmg{position:absolute;font-family:var(--serif);font-weight:700;font-size:30px;text-shadow:0 2px 0 #000,0 0 12px #000;animation:dmgA 1s ease-out forwards;transform:translate(-50%,-50%);white-space:nowrap}
.dmg.crit{font-size:44px;color:#ffe08a}
.dmg.heal{color:#8fe8a8}.dmg.mp{color:#8fc0ff}.dmg.pl{color:#ff9aa4}.dmg.sys{font-size:20px;color:var(--gold2)}
@keyframes dmgA{0%{opacity:0;margin-top:10px;scale:.6}15%{opacity:1;margin-top:0;scale:1.15}100%{opacity:0;margin-top:-56px;scale:1}}
#btlFlash{position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none;opacity:0}
#btlFlash.hit{animation:flashR .35s}
#btlFlash.mag{animation:flashB .45s}
#btlFlash.heal{animation:flashG .5s}
@keyframes flashR{0%{opacity:.7;background:radial-gradient(circle,rgba(0,0,0,0) 30%,rgba(220,40,60,.8))}100%{opacity:0}}
@keyframes flashB{0%{opacity:.75;background:radial-gradient(circle,rgba(160,190,255,.8),rgba(60,70,200,.2))}100%{opacity:0}}
@keyframes flashG{0%{opacity:.6;background:radial-gradient(circle,rgba(140,255,170,.6),rgba(0,0,0,0) 70%)}100%{opacity:0}}
#btlBanner{position:absolute;left:0;right:0;top:34%;text-align:center;pointer-events:none;opacity:0;font-family:var(--serif);font-size:clamp(20px,5.4vw,40px);
  letter-spacing:.2em;color:#ffe9b0;text-shadow:0 0 26px rgba(255,160,60,.8),0 2px 0 #000}
#btlBanner.show{animation:bannerA 2.4s ease forwards}
#btlBanner.red{color:#ff8f9c;text-shadow:0 0 30px rgba(255,40,80,.85),0 2px 0 #000}
.shk-s{animation:shk .35s}
#btlLog{height:72px;overflow:hidden;font-size:14px;line-height:1.35;padding:6px 10px;border-radius:10px;background:rgba(10,12,30,.82);
  border:1px solid rgba(226,180,90,.18);display:flex;flex-direction:column;justify-content:flex-end}
#btlLog div{opacity:.7}#btlLog div:last-child{opacity:1;color:var(--text)}
#btlPlayer{position:relative;padding:8px 12px;border-radius:10px;display:grid;grid-template-columns:auto 1fr 1fr;gap:4px 12px;align-items:center;font-size:13px}
#btlPlayer .n{font-family:var(--serif);letter-spacing:.14em;color:var(--gold2)}
#btlPlayer .bw{display:flex;align-items:center;gap:6px}
#btlPlayer .bw .bar{flex:1}
#btlBuffs{grid-column:1/-1;font-size:11px;color:var(--dim);min-height:14px}
#btlActions{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
#btlActions .btn{min-height:54px;font-size:14px;letter-spacing:.1em;padding:8px 6px}
#btlActions .sub{grid-column:1/-1;display:flex;flex-direction:column;gap:6px;max-height:34vh;overflow:auto}
#btlActions .sub .btn{display:flex;justify-content:space-between;text-align:left;letter-spacing:.04em;font-size:14px}
#btlResult{position:absolute;top:0;right:0;bottom:0;left:0;z-index:3;display:flex;align-items:center;justify-content:center;padding:14px;background:rgba(3,4,10,.78)}
