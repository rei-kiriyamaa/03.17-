    m.objs.forEach(o=>{ if(o.k==='fragment') clearAround(m,o.x,o.y,1); });
    m.portals.forEach(p=>{ for(let j=0;j<p.h;j++) for(let i=0;i<p.w;i++) clearAround(m,p.x+i,p.y+j,1); });
  });
