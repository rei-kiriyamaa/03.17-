const SOLID = new Set('~#TYFRHWLBXSbthCnaxrPfogveqKZ'.split(''));
const MAPS = {};

function newMap(id,name,w,h,base,o){
  const g = []; for(let y=0;y<h;y++) g.push(new Array(w).fill(base));
  return Object.assign({id:id,name:name,w:w,h:h,g:g,base:base,meta:new Uint8Array(w*h),specials:[],lights:[],
    portals:[],objs:[],spawns:[],under:{},theme:'town',indoor:false,mood:'town'},o||{});
}
const GROUND = new Set('.,=pdwckuN~'.split(''));
function setT(m,x,y,c){
  if(x<0||y<0||x>=m.w||y>=m.h) return;
  if(!GROUND.has(c)){ const k=y*m.w+x, old=m.g[y][x]; if(m.under[k]===undefined && GROUND.has(old)) m.under[k]=old; }
  m.g[y][x] = c;
}
function getT(m,x,y){ return (x<0||y<0||x>=m.w||y>=m.h) ? '#' : m.g[y][x]; }
function rect(m,c,x,y,w,h){ for(let j=y;j<y+h;j++) for(let i=x;i<x+w;i++) setT(m,i,j,c); }
function border(m,c){ rect(m,c,0,0,m.w,1); rect(m,c,0,m.h-1,m.w,1); rect(m,c,0,0,1,m.h); rect(m,c,m.w-1,0,1,m.h); }
function building(m,x,y,w,h,doorX,style){
  for(let j=0;j<h;j++) for(let i=0;i<w;i++){
    let c; if(j<h-2) c='R'; else if(j===h-2) c=(i%2===1&&i>0&&i<w-1)?'W':'H'; else c='H';
    setT(m,x+i,y+j,c); m.meta[(y+j)*m.w+(x+i)] = style;
  }
  setT(m,doorX,y+h-1,'D');
}
function scatter(m,ch,n,seed,zone,loose){
  let placed = 0;
  for(let a=0; a<n*14 && placed<n; a++){
    const x = Math.floor(hash(a,seed,11)*m.w), y = Math.floor(hash(a,seed,23)*m.h);
    if(zone && !zone(x,y)) continue;
    const t = getT(m,x,y); if(t!==m.base && t!==',') continue;
    if(!loose){ let ok = true; for(let j=-1;j<=1&&ok;j++) for(let i=-1;i<=1;i++){ const q=getT(m,x+i,y+j); if(q!=='.'&&q!==',') { ok=false; break; } } if(!ok) continue; }
    setT(m,x,y,ch); placed++;
  }
}
function clearAround(m,tx,ty,r){
  for(let j=-r;j<=r;j++) for(let i=-r;i<=r;i++){
    const x=tx+i, y=ty+j; if(x<=0||y<=0||x>=m.w-1||y>=m.h-1) continue;
    const t = getT(m,x,y);
    if(t==='T'||t==='Y'||t==='B'||t==='X'||t==='F') setT(m,x,y,m.base);
  }
}
function lamp(m,x,y){ setT(m,x,y,'L'); m.lights.push({x:(x+.5)*TS,y:y*TS+6,r:96,c:'255,210,130',night:true}); }
function light(m,x,y,r,c,night){ m.lights.push({x:(x+.5)*TS,y:(y+.5)*TS,r:r,c:c||'255,210,130',night:!!night}); }
function portal(m,x,y,w,h,to,tx,ty,dir,lock,name){ m.portals.push({x:x,y:y,w:w,h:h,to:to,tx:tx,ty:ty,dir:dir||'down',lock:lock||null,name:name||''}); }
function obj(m,o){ m.objs.push(o); return o; }
function interior(id,name,w,h,floor,doorX,mood){
  const m = newMap(id,name,w,h,floor,{indoor:true,theme:'indoor',mood:mood||'town'});
  border(m,'H'); rect(m,'H',0,0,w,2); setT(m,doorX,h-1,'D'); return m;
}
