<script>
(function(){
'use strict';
/* =====================================================================
   ECHOES OF THE FORGOTTEN  -  single file RPG
   Sections: CONFIG, UTILS, STORAGE, DATA, STATE, AUDIO, WORLD, SPRITES,
   QUEST, DIALOGUE, COMBAT, PUZZLE, SHOP, CUTSCENE, UI, INPUT, GAME LOOP
   ===================================================================== */

/* ===================== CONFIG ===================== */
const TS = 32, VERSION = 1, MAXLV = 15, DAY_RATE = 2;
const SAVE_PREFIX = 'eotf_slot_', SETTINGS_KEY = 'eotf_settings_v1', META_KEY = 'eotf_meta_v1';
const ST = {MENU:'MENU',PLAYING:'PLAYING',DIALOGUE:'DIALOGUE',BATTLE:'BATTLE',INVENTORY:'INVENTORY',PAUSE:'PAUSE',
  PUZZLE:'PUZZLE',CUTSCENE:'CUTSCENE',GAMEOVER:'GAMEOVER',VICTORY:'VICTORY',SHOP:'SHOP'};
const PERIODS = ['Morning','Afternoon','Evening','Night'];
const PUZZLE_CODE = [4,3,1,3];

/* ===================== UTILS ===================== */
const $ = id => document.getElementById(id);
const clamp = (v,a,b) => Math.max(a,Math.min(b,v));
const rnd = (a,b) => a + Math.random()*(b-a);
const rint = (a,b) => Math.floor(a + Math.random()*(b-a+1));
const lerp = (a,b,t) => a + (b-a)*t;
function hash(x,y,s){
  let h = (Math.imul(x|0,374761393) + Math.imul(y|0,668265263) + Math.imul((s||0)+1,2147483647))|0;
  h = Math.imul(h ^ (h>>>13),1274126177); h = h ^ (h>>>16);
  return ((h>>>0)%10000)/10000;
}
function el(tag,cls,html){ const e=document.createElement(tag); if(cls) e.className=cls; if(html!==undefined) e.innerHTML=html; return e; }
function esc(s){ return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function pad2(n){ return (n<10?'0':'')+n; }
function isNum(v){ return typeof v==='number' && isFinite(v); }
function num(v,def,min,max){ v = isNum(v)?v:def; return clamp(v,min,max); }

/* managed timers (tagged so they can be cleared on state change) */
const Timers = {
  map:new Map(),
  later(ms,fn,tag){
    const t = tag||'misc';
    const id = setTimeout(()=>{ const s=this.map.get(t); if(s) s.delete(id); fn(); },ms);
    if(!this.map.has(t)) this.map.set(t,new Set());
    this.map.get(t).add(id); return id;
  },
  clearTag(tag){ const s=this.map.get(tag); if(s){ s.forEach(clearTimeout); s.clear(); } },
  clearAll(){ this.map.forEach(s=>{ s.forEach(clearTimeout); s.clear(); }); }
};

/* ===================== STORAGE ===================== */
const Store = {
  get(k){ try{ return localStorage.getItem(k); }catch(e){ return null; } },
  set(k,v){ try{ localStorage.setItem(k,v); return true; }catch(e){ return false; } },
  del(k){ try{ localStorage.removeItem(k); }catch(e){} }
};
const DEFAULT_SETTINGS = {sound:true,music:true,speed:1,particles:true,touch:'auto',lang:'id'};
const ID = {};   // English -> Indonesian story text (filled in by the translation table)
function tr(s){ if(typeof s==='string' && settings.lang==='id' && ID[s]!==undefined) return ID[s]; return s; }
let settings = Object.assign({},DEFAULT_SETTINGS);
let meta = {endings:{A:false,B:false,C:false}};
function loadSettings(){
  try{
    const raw = Store.get(SETTINGS_KEY);
    if(raw){ const o = JSON.parse(raw);
      settings.sound = o.sound!==false; settings.music = o.music!==false;
      settings.speed = num(o.speed,1,0,3); settings.particles = o.particles!==false;
      settings.touch = (o.touch==='on'||o.touch==='off')?o.touch:'auto'; settings.lang = o.lang==='en'?'en':'id'; }
  }catch(e){ settings = Object.assign({},DEFAULT_SETTINGS); }
  try{
    const raw = Store.get(META_KEY);
    if(raw){ const o = JSON.parse(raw); if(o && o.endings){ ['A','B','C'].forEach(k=>meta.endings[k]=!!o.endings[k]); } }
  }catch(e){}
}
function saveSettings(){ Store.set(SETTINGS_KEY,JSON.stringify(settings)); }
function saveMeta(){ Store.set(META_KEY,JSON.stringify(meta)); }

/* ===================== DATA ===================== */
const ITEMS = {
  potion:{n:'Potion',t:'item',d:'Restores 50 HP.',heal:50,price:20},
  hi_potion:{n:'Hi-Potion',t:'item',d:'Restores 120 HP.',heal:120,price:60},
  ether:{n:'Ether',t:'item',d:'Restores 30 MP.',mp:30,price:30},
  rusty_sword:{n:'Rusty Sword',t:'weapon',d:'A pitted blade that still holds an edge. ATK +5.',bonus:{atk:5},price:40},
  iron_sword:{n:'Iron Sword',t:'weapon',d:'Honest steel from Elias\' back room. ATK +9.',bonus:{atk:9},price:150},
  hollow_edge:{n:'Hollow Edge',t:'weapon',d:'A blade that hums with forgotten oaths. ATK +13, MAGIC +2.',bonus:{atk:13,mag:2},price:300},
  old_coat:{n:'Old Coat',t:'armor',d:'Worn thin, but oddly familiar. DEF +3.',bonus:{def:3},price:30},
  leather_vest:{n:'Leather Vest',t:'armor',d:'Stitched and oiled. DEF +6.',bonus:{def:6},price:100},
  knight_mail:{n:'Knight Mail',t:'armor',d:'Hollow plate, still warm to the touch. DEF +10.',bonus:{def:10},price:260},
  broken_pendant:{n:'Broken Pendant',t:'accessory',d:'A cracked clock-face on a faded cord. LUCK +2.',bonus:{lck:2},price:20},
  silver_ring:{n:'Silver Ring',t:'accessory',d:'Cold silver etched with tiny stars. MAGIC +3.',bonus:{mag:3},price:90},
  clock_charm:{n:'Clock Charm',t:'accessory',d:'Its tiny hands never stop. SPEED +3.',bonus:{spd:3},price:120},
  old_key:{n:'Old Key',t:'key',d:'A rusty key found inside the library.'},
  old_record:{n:'Old Record',t:'key',d:'A torn page about the night the bell rang twice.'},
  echo_fragment:{n:'Echo Fragment',t:'key',d:'A mysterious fragment containing someone\'s memory.'}
};
const SHOP_STOCK = ['potion','hi_potion','ether','iron_sword','leather_vest','silver_ring'];
const SKILLS = [
  {id:'slash',n:'SLASH',lv:1,mp:5,d:'Damage x1.5',kind:'phys',mult:1.5},
  {id:'focus',n:'FOCUS',lv:2,mp:8,d:'Raises ATK for 3 turns',kind:'buff'},
  {id:'heavy',n:'HEAVY STRIKE',lv:3,mp:10,d:'Damage x2',kind:'phys',mult:2},
  {id:'echo',n:'ECHO BURST',lv:4,mp:15,d:'Magic damage',kind:'magic'},
  {id:'mend',n:'MEND',lv:5,mp:10,d:'Restores HP',kind:'heal'}
];
const ENEMIES = {
  wolf:{n:'SHADOW WOLF',hp:80,atk:15,def:5,spd:12,exp:24,gold:12,drop:['potion',0.22]},
  knight:{n:'HOLLOW KNIGHT',hp:150,atk:22,def:15,spd:8,exp:60,gold:28,drop:['ether',0.25]},
  eater:{n:'MEMORY EATER',hp:220,atk:28,def:12,spd:10,exp:110,gold:50,drop:['hi_potion',0.3]},
  clockkeeper:{n:'THE CLOCKKEEPER',hp:500,atk:25,def:9,spd:11,exp:320,gold:200,boss:true}
};
const CLUES = {
  c1:'The clock stopped at 03:17.',
  c2:'Someone erased the records from the library.',
  c3:'Lena knows the player\'s name.',
  c4:'Every soul in Asteria lost the same day, and not one of them can say which.',
  c5:'The Old Record: "The bell was rung twice that night. The second ring was not the Keeper\'s."',
  c6:'The Keeper\'s house stands in the Old Forest. Its key was hidden among the library\'s oldest histories.',
  c7:'The Keeper\'s journal: "The boy returns. Seven times now. Each time, he reaches for the bell."',
  c8:'Echo Fragments are pieces of the forgotten day, scattered when the bell rang the second time.',
  c9:'Lena casts no shadow at night.',
  c10:'The clock tablet: the forgotten hour is read digit by digit; the old dial has only four numerals and what overflows wraps around. Nothing is the last numeral.',
  c11:'At night the tower\'s gears turn on their own, always toward 03:17.',
  c12:'The Clockkeeper knew the player\'s face. "You were here before."',
  c13:'The player\'s name is Aren.'
};
const CLUE_ORDER = ['c1','c2','c3','c4','c5','c6','c7','c8','c9','c10','c11','c12','c13'];
const MEMORIES = {
  m1:{title:'MEMORY FRAGMENT #01',lines:['A child is standing near the Clock Tower.','Her hands are clenched around something small.','Someone says:','"You promised you would come back."','The child never turns around.'],sum:'A child waits near the Clock Tower. "You promised you would come back."'},
  m2:{title:'MEMORY FRAGMENT #02',lines:['A workshop full of ticking clocks.','A tall man presses a key into your palm.','"Look after her, Aren."','"And if the bell ever tolls a second time...','do not answer it."'],sum:'A tall man in a clock workshop: "If the bell ever tolls a second time, do not answer it."'},
  m3:{title:'MEMORY FRAGMENT #03',lines:['Rain. The tower stairs, slick as glass.','A small hand slips out of yours.','"Lena!"','Above you the great bell tolls.','Once.','Twice.','And the world goes quiet.'],sum:'Rain on the tower stairs. A small hand slips away. The bell tolls twice.'},
  m4:{title:'MEMORY FRAGMENT #04',lines:['Stars through a broken roof.','A little girl asleep against your shoulder.','"Tomorrow," she whispers,','"we ring the morning bell together."'],sum:'Stars through a broken roof. "Tomorrow we ring the morning bell together."'}
};
const CHARS = {
  rowan:{n:'ROWAN',role:'Captain of the Watch',bio:'Gruff, dutiful, dry as old bread. Keeps the Clock Tower gate sealed and the town in order.'},
  elias:{n:'ELIAS',role:'Shopkeeper',bio:'A cheerful merchant who remembers every price in Asteria and nothing else about that day.'},
  mira:{n:'MIRA',role:'Librarian',bio:'Soft-spoken keeper of the town\'s records. The blank shelves haunt her.'},
  lena:{n:'LENA',role:'A mysterious girl',bio:'She knows your name. She will not say it.'},
  arden:{n:'FATHER ARDEN',role:'Chapel of the Quiet Hour',bio:'Calm and weary. Wakes every night to a bell no one else hears.'},
  marta:{n:'MARTA',role:'Innkeeper',bio:'Loud, warm, and certain she baked a pie for someone.'},
  tobin:{n:'TOBIN',role:'A boy of Asteria',bio:'Collects stopped clocks. Every one of them says 03:17.'},
  orin:{n:'THE CLOCKKEEPER',role:'Orin Vale',bio:'The last keeper of the tower. He has been waiting a very long time.'}
};
const REL_NPCS = ['lena','mira','elias','rowan','arden'];

/* ===================== STATE ===================== */
let S = null;                       // the save-able game state
const G = {                         // runtime-only state
  state:ST.MENU, prev:null, map:null, mapId:null, cam:{x:0,y:0},
  pl:{x:0,y:0,dir:'down',step:0,moving:false,cool:0},
  npcs:[], enemies:[], objs:[], parts:[], trans:null, invul:0, target:null,
  t:0, lastPeriod:-1, strike:0, touchOn:false, areaT:0, portalCool:0, slashT:0, fogT:0
};

function defaultState(){
  return {
    v:VERSION, saved:0, day:1, min:390, play:0, introDone:false,
    p:{lv:1,exp:0,hp:100,mp:30,gold:50,b:{mhp:100,mmp:30,atk:12,def:6,mag:8,spd:10,lck:5}},
    pos:{area:'town',x:15.5*TS,y:14.5*TS,dir:'down'},
    inv:{potion:3}, eq:{weapon:null,armor:'old_coat',accessory:null},
    flags:{}, cnt:{}, clues:[], mems:[], rel:{lena:0,mira:0,elias:0,rowan:0,arden:0},
    quests:{}, objDone:{}, killed:{}, opened:{}, met:{}, ending:null, endProg:{choice:null,truth:false}
  };
}

/* ---- flags / counters ---- */
function F(k){ return !!(S && S.flags[k]); }
function setF(k,v){ S.flags[k] = (v===undefined)?true:v; checkQuests(); }
function cnt(k){ return (S && S.cnt[k]) || 0; }
function addCnt(k,n){ S.cnt[k] = cnt(k)+(n||1); checkQuests(); }
function owned(id){ return (S.inv[id]||0)>0 || S.eq.weapon===id || S.eq.armor===id || S.eq.accessory===id; }
function playerName(){ return S.clues.indexOf('c13')>=0 ? 'AREN' : '???'; }

/* ---- stats ---- */
function equipBonus(k){
  let v = 0;
  ['weapon','armor','accessory'].forEach(sl=>{ const id=S.eq[sl]; if(id && ITEMS[id] && ITEMS[id].bonus && ITEMS[id].bonus[k]) v += ITEMS[id].bonus[k]; });
  return v;
}
function stat(k){ return S.p.b[k] + equipBonus(k); }
function clampVitals(){ S.p.hp = clamp(Math.round(S.p.hp),0,stat('mhp')); S.p.mp = clamp(Math.round(S.p.mp),0,stat('mmp')); }
function needExp(lv){ return 20 + lv*lv*8; }
function healHp(n){ const b=S.p.hp; S.p.hp = clamp(S.p.hp+n,0,stat('mhp')); return S.p.hp-b; }
function healMp(n){ const b=S.p.mp; S.p.mp = clamp(S.p.mp+n,0,stat('mmp')); return S.p.mp-b; }
function fullHeal(){ S.p.hp = stat('mhp'); S.p.mp = stat('mmp'); }
function knownSkills(){ return SKILLS.filter(s=>s.lv<=S.p.lv); }

function levelUp(){
  S.p.lv++; const b = S.p.b;
  b.mhp += 14; b.mmp += 4; b.atk += 2; b.def += 1; b.mag += 2; b.spd += 1; if(S.p.lv%2===1) b.lck += 1;
  fullHeal();
}
function addExp(n){
  const ups = [];
  if(S.p.lv>=MAXLV) return ups;
  S.p.exp += Math.max(0,Math.round(n));
  while(S.p.lv<MAXLV && S.p.exp>=needExp(S.p.lv)){
    S.p.exp -= needExp(S.p.lv); levelUp();
    ups.push({lv:S.p.lv, skills:SKILLS.filter(s=>s.lv===S.p.lv).map(s=>s.n)});
  }
  if(S.p.lv>=MAXLV) S.p.exp = 0;
  return ups;
}
function gainExpToast(n){
  const ups = addExp(n);
  toast('+'+n+' EXP','good');
  ups.forEach(u=>{ toast('LEVEL UP!  LV '+u.lv+(u.skills.length?'  ·  Skill: '+u.skills.join(', '):''),'good'); });
  if(ups.length) Sound.play('levelup');
}

/* ---- inventory / equipment ---- */
function addItem(id,n){ if(!ITEMS[id]) return; S.inv[id] = (S.inv[id]||0)+(n||1); }
function removeItem(id,n){
  n = n||1; if(!(S.inv[id]>0)) return false;
  S.inv[id] -= n; if(S.inv[id]<=0) delete S.inv[id]; return true;
}
function slotOf(id){ const t = ITEMS[id] && ITEMS[id].t; return (t==='weapon'||t==='armor'||t==='accessory')?t:null; }
function equipItem(id){
  const sl = slotOf(id); if(!sl || !(S.inv[id]>0)) return false;
  const old = S.eq[sl]; removeItem(id,1); if(old) addItem(old,1);
  S.eq[sl] = id; clampVitals(); return true;
}
function unequip(sl){ const old=S.eq[sl]; if(!old) return; S.eq[sl]=null; addItem(old,1); clampVitals(); }
function giveItem(id,n,quiet){
  if(!ITEMS[id]) return;
  addItem(id,n||1);
  const sl = slotOf(id); if(sl && !S.eq[sl]) equipItem(id);
  if(!quiet){ toast('Obtained '+ITEMS[id].n+((n||1)>1?' x'+n:''),'good'); Sound.play('pickup'); }
  checkQuests();
}
function useItemField(id){
  const it = ITEMS[id]; if(!it || !(S.inv[id]>0)) return 'Nothing happens.';
  if(it.heal){ if(S.p.hp>=stat('mhp')) return 'HP is already full.'; const g=healHp(it.heal); removeItem(id,1); Sound.play('heal'); return 'Restored '+g+' HP.'; }
  if(it.mp){ if(S.p.mp>=stat('mmp')) return 'MP is already full.'; const g=healMp(it.mp); removeItem(id,1); Sound.play('heal'); return 'Restored '+g+' MP.'; }
  return 'This cannot be used here.';
}

/* ---- clues / memories / relationships ---- */
function addClue(id){
  if(!CLUES[id] || S.clues.indexOf(id)>=0) return false;
  S.clues.push(id); toast('CLUE #'+pad2(CLUE_ORDER.indexOf(id)+1)+' recorded in your journal','clue'); Sound.play('pickup'); return true;
}
function addMemory(id){ if(MEMORIES[id] && S.mems.indexOf(id)<0) S.mems.push(id); }
function addRel(id,n){
  if(S.rel[id]===undefined) return;
  const b = S.rel[id]; S.rel[id] = clamp(b+n,0,100);
  const d = S.rel[id]-b;
  if(d>0) toast(CHARS[id].n+' trusts you a little more','good'); else if(d<0) toast(CHARS[id].n+' seems displeased','bad');
}
function meet(id){ if(CHARS[id] && !S.met[id]){ S.met[id]=1; } }

/* ---- time ---- */
function periodIdx(){ const h=S.min/60; if(h>=5&&h<12) return 0; if(h>=12&&h<17) return 1; if(h>=17&&h<21) return 2; return 3; }
function periodName(){ return PERIODS[periodIdx()]; }
function isNight(){ return periodIdx()===3; }
function timeStr(){ const m=Math.floor(S.min); return pad2(Math.floor(m/60)%24)+':'+pad2(m%60); }
function tickTime(dt){
  S.min += dt*DAY_RATE;
  if(S.min>=1440){ S.min -= 1440; S.day++; toast('DAY '+S.day,'good'); }
}
function sleepUntilMorning(){
  if(S.min>=360) S.day++;
  S.min = 360;
}

/* ---- toasts / tracker ---- */
function toast(msg,kind){
  const box = $('toasts'); if(!box) return;
  while(box.children.length>=3) box.removeChild(box.firstChild);
  const t = el('div','toast '+(kind||''),esc(tr(msg))); box.appendChild(t);
  Timers.later(3100,()=>{ if(t.parentNode) t.parentNode.removeChild(t); },'toast');
}
function updateTracker(){
  const t = $('tracker'); if(!t || !S) return;
  let id = null;
  for(const k in S.quests){ if(S.quests[k]==='active' && QUESTS[k].main){ id=k; break; } }
  if(!id){ for(const k in S.quests){ if(S.quests[k]==='active'){ id=k; break; } } }
  if(!id){ t.innerHTML = ''; return; }
  const o = qObjs(id).find(x=>!x.done);
  t.innerHTML = '<div class="tq">◆ '+esc(QUESTS[id].title)+'</div><div class="to">'+esc(o?tr(o.t):'...')+'</div>';
}

