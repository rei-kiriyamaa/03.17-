const MOODS = {
  title: {root:73.4, scale:[0,3,7,10,12,15], gap:2.6, vol:.16, drone:.07},
  town:  {root:73.4, scale:[0,2,3,7,9,12],  gap:3.0, vol:.13, drone:.05},
  forest:{root:55,   scale:[0,3,5,7,10,12], gap:3.4, vol:.12, drone:.07},
  house: {root:82.4, scale:[0,1,5,7,8,12],  gap:3.8, vol:.11, drone:.06},
  tower: {root:82.4, scale:[0,3,7,10,12,14],gap:2.8, vol:.14, drone:.08},
  ruins: {root:61.7, scale:[0,1,6,7,12,13], gap:3.2, vol:.12, drone:.09},
  battle:{root:73.4, scale:[0,3,5,7,10],    gap:.9,  vol:.12, drone:.09, pulse:.5},
  boss:  {root:55,   scale:[0,1,3,6,7],     gap:.7,  vol:.14, drone:.12, pulse:.4},
  quiet: {root:55,   scale:[0,7,12],        gap:5,   vol:.08, drone:.03}
};
const Sound = {
  ctx:null, ready:false, mood:'', noteT:1, pulseT:0,
  unlock(){
    if(this.ctx){ if(this.ctx.state==='suspended'){ try{ this.ctx.resume(); }catch(e){} } return; }
    try{
      const AC = window.AudioContext || window.webkitAudioContext; if(!AC) return;
      const c = this.ctx = new AC();
      this.master = c.createGain(); this.master.gain.value = .9; this.master.connect(c.destination);
      this.sfxG = c.createGain(); this.sfxG.gain.value = .55; this.sfxG.connect(this.master);
      this.musG = c.createGain(); this.musG.gain.value = 0; this.musG.connect(this.master);
      this.d1 = c.createOscillator(); this.d2 = c.createOscillator(); this.dg = c.createGain(); this.dg.gain.value = 0;
      this.d1.type = 'sine'; this.d2.type = 'triangle'; this.d1.frequency.value = 73; this.d2.frequency.value = 110;
      this.d1.connect(this.dg); this.d2.connect(this.dg); this.dg.connect(this.musG); this.d1.start(); this.d2.start();
      this.ready = true; this.applyVol();
      if(this.mood){ const m = this.mood; this.mood = ''; this.setMood(m); }
    }catch(e){ this.ctx = null; this.ready = false; }
  },
  applyVol(){ if(this.ready) this.musG.gain.setTargetAtTime(settings.music?.38:0,this.ctx.currentTime,.25); },
  setMood(m){
    if(this.mood===m) return; this.mood = m;
    const M = MOODS[m]; if(!this.ready || !M) return;
    const t = this.ctx.currentTime;
    this.d1.frequency.setTargetAtTime(M.root,t,.8); this.d2.frequency.setTargetAtTime(M.root*1.5,t,.8);
    this.dg.gain.setTargetAtTime(M.drone,t,1.2);
  },
  update(dt){
    if(!this.ready || !settings.music) return;
    const M = MOODS[this.mood]; if(!M) return;
    this.noteT -= dt;
    if(this.noteT<=0){
      this.noteT = M.gap*(.7+Math.random()*.8);
      const semi = M.scale[rint(0,M.scale.length-1)];
      this.bell(M.root*2*Math.pow(2,semi/12),M.vol);
    }
    if(M.pulse){ this.pulseT -= dt; if(this.pulseT<=0){ this.pulseT = M.pulse; this.thump(M.root,M.vol*1.6); } }
  },
  bell(f,v){
    const c = this.ctx, t = c.currentTime;
    [[1,1],[2.01,.35]].forEach(p=>{
      const o = c.createOscillator(), g = c.createGain();
      o.type = 'sine'; o.frequency.value = f*p[0];
      g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(v*p[1],t+.02); g.gain.exponentialRampToValueAtTime(.0001,t+2.6);
      o.connect(g); g.connect(this.musG); o.start(t); o.stop(t+2.7);
    });
  },
  thump(f,v){
    const c = this.ctx, t = c.currentTime, o = c.createOscillator(), g = c.createGain();
    o.type = 'sine'; o.frequency.setValueAtTime(f*1.4,t); o.frequency.exponentialRampToValueAtTime(f*.5,t+.18);
    g.gain.setValueAtTime(v,t); g.gain.exponentialRampToValueAtTime(.0001,t+.22);
    o.connect(g); g.connect(this.musG); o.start(t); o.stop(t+.25);
  },
  tone(f,dur,type,vol,to,delay){
    if(!this.ready || !settings.sound) return;
    const c = this.ctx, t = c.currentTime+(delay||0), o = c.createOscillator(), g = c.createGain();
    o.type = type||'sine'; o.frequency.setValueAtTime(f,t);
    if(to) o.frequency.exponentialRampToValueAtTime(Math.max(20,to),t+dur);
    g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(vol||.2,t+.008); g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(g); g.connect(this.sfxG); o.start(t); o.stop(t+dur+.03);
  },
  noise(dur,vol,freq,delay){
    if(!this.ready || !settings.sound) return;
    const c = this.ctx, t = c.currentTime+(delay||0), n = Math.max(1,Math.floor(c.sampleRate*dur));
    const buf = c.createBuffer(1,n,c.sampleRate), d = buf.getChannelData(0);
    for(let i=0;i<n;i++) d[i] = (Math.random()*2-1)*(1-i/n);
    const s = c.createBufferSource(); s.buffer = buf;
    const f = c.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = freq||1500;
    const g = c.createGain(); g.gain.value = vol||.2;
    s.connect(f); f.connect(g); g.connect(this.sfxG); s.start(t);
  },
  arp(notes,step,type,vol){ notes.forEach((f,i)=>this.tone(f,.28,type||'sine',vol||.2,null,i*step)); },
  blip(f){ this.tone(f||300,.045,'square',.05); },
  play(name){
    if(!this.ready || !settings.sound) return;
    switch(name){
      case 'click': this.tone(660,.06,'square',.1); break;
      case 'back': this.tone(440,.07,'square',.08); break;
      case 'error': this.tone(150,.16,'square',.14); break;
      case 'door': this.tone(130,.14,'sine',.35,60); this.noise(.12,.12,500); break;
      case 'slash': this.noise(.18,.4,2200); this.tone(900,.18,'triangle',.15,250); break;
      case 'hit': this.noise(.14,.35,900); this.tone(220,.16,'sawtooth',.2,70); break;
      case 'crit': this.noise(.2,.5,1400); this.tone(1100,.22,'square',.14,300); this.tone(180,.2,'sawtooth',.25,50); break;
      case 'damage': this.tone(200,.28,'sawtooth',.28,55); this.noise(.12,.25,600); break;
      case 'magic': this.tone(400,.4,'sine',.22,1400); this.tone(800,.4,'triangle',.1,1800,.05); break;
      case 'heal': this.arp([523,659,784,1047],.07,'sine',.2); break;
      case 'levelup': this.arp([392,494,587,784,988,1175],.09,'triangle',.22); break;
      case 'quest': this.arp([523,659,880],.12,'triangle',.2); break;
      case 'pickup': this.tone(880,.09,'sine',.2); this.tone(1175,.14,'sine',.2,null,.08); break;
      case 'puzzle': this.arp([392,494,587,784,988],.14,'sine',.22); break;
      case 'boss': this.tone(90,1.6,'sawtooth',.3,36); this.noise(1.4,.3,200); this.tone(180,1.4,'triangle',.12,60); break;
      case 'win': this.arp([523,659,784,1047,1319],.11,'triangle',.22); break;
      case 'lose': this.arp([392,311,262,196],.22,'sawtooth',.18); break;
      case 'fragment': this.arp([440,554,659,880,1108],.16,'sine',.2); this.tone(220,1.4,'sine',.15); break;
      case 'bell': this.tone(196,2.2,'sine',.4); this.tone(392,2.2,'sine',.15); this.tone(588,1.8,'sine',.08); break;
      case 'step': this.noise(.05,.05,400); break;
    }
  }
};

